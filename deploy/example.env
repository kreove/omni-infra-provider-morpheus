# Published image tag, or a locally built image.
# Releases are prereleases while this provider is alpha, so there is no
# :latest tag -- pin an explicit version from the releases page.
PROVIDER_IMAGE=ghcr.io/kreove/omni-infra-provider-morpheus:VERSION

# Omni
OMNI_ENDPOINT=https://your-account.omni.siderolabs.io
# Single-line value printed by:
#   omnictl infraprovider create morpheus
OMNI_SERVICE_ACCOUNT_KEY=

# Morpheus appliance
MORPHEUS_ENDPOINT=https://morpheus.example.com

# Authenticate with an API token (Morpheus UI: user settings -> API access),
# or with a username and password. The token takes precedence when both are set.
MORPHEUS_TOKEN=
#MORPHEUS_USERNAME=
#MORPHEUS_PASSWORD=

# NoCloud server
#
# Morpheus does not hand user data to the guest untouched -- it renders its own
# cloud-config and folds user data into that document's runcmd list, which Talos
# discards. The provider therefore serves the Talos config itself and points each
# VM at it through the guest's SMBIOS serial.
#
# This must be an address provisioned machines can reach: it is where they fetch
# their machine config from, and without it they boot into maintenance mode and
# never join Omni. Use the provider host's address on the machines' network, not
# localhost, and make sure the port is reachable from the VM network.
NOCLOUD_SERVER_URL=http://provider-host.example.com:9080
#NOCLOUD_SERVER_BIND_ADDRESS=:9080
